{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "bookmethat.com"
        }
      ],
      "destination": "https://www.bookmethat.com/$1",
      "statusCode": 301
    },
    { "source": "/esims", "destination": "/esim", "statusCode": 301 },
    { "source": "/eSIM", "destination": "/esim", "statusCode": 301 },
    { "source": "/connectivity", "destination": "/esim", "statusCode": 301 },
    { "source": "/car-rentals", "destination": "/car-rental", "statusCode": 301 },
    { "source": "/cars", "destination": "/car-rental", "statusCode": 301 },
    { "source": "/flight", "destination": "/flights", "statusCode": 301 },
    { "source": "/about-us", "destination": "/about", "statusCode": 301 },
    { "source": "/disclosure", "destination": "/about", "statusCode": 301 },
    { "source": "/impressum", "destination": "/contact", "statusCode": 301 },
    { "source": "/support", "destination": "/contact", "statusCode": 301 },
    { "source": "/sitemap", "destination": "/sitemap.xml", "statusCode": 301 }
  ],
  "rewrites": [
    {
      "source": "/(favicon.png|sitemap.xml|robots.txt|llms.txt|llms-full.txt)",
      "destination": "/$1"
    },
    {
      "source": "/((?!assets/|favicon.png|sitemap.xml|robots.txt|llms.txt|llms-full.txt).*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(favicon.png|sitemap.xml|robots.txt|llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
